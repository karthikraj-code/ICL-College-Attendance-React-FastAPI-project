# Copy this file to .env and fill in values.
# Never commit .env to GitHub.
#
# LOCAL (Docker Compose on your laptop) and EC2 (Docker Compose on the server)
# use the SAME variable names. Inside Compose, DB_HOST must be the MySQL
# *service name*, not localhost.

# --- MySQL container ---
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=attendance_db
MYSQL_USER=attendance_user
MYSQL_PASSWORD=change_this_db_password

# --- FastAPI → MySQL (inside Docker Compose) ---
# DB_HOST=mysql  is required. "mysql" is the service name in docker-compose.yml.
# Do NOT use localhost here when running via Docker Compose.
DB_HOST=mysql
DB_PORT=3306
DB_USER=attendance_user
DB_PASSWORD=change_this_db_password
DB_NAME=attendance_db
